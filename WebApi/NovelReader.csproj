<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>098c368f-d5fa-43b9-8053-297b7e3e91aa</UserSecretsId>
    <!-- wwwroot is served by UseStaticFiles (ClientAssets), not MapStaticAssets, so the static
         web assets pipeline would only add .gz/.br copies and a manifest that nothing reads. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovelReader.Data.Mongo\NovelReader.Data.Mongo.csproj" />
    <ProjectReference Include="..\NovelReader.Data.Sqlite\NovelReader.Data.Sqlite.csproj" />
    <ProjectReference Include="..\NovelReader.Domain\NovelReader.Domain.csproj" />
    <ProjectReference Include="..\NovelReader.Retrievers\NovelReader.Retrievers.csproj" />
    <ProjectReference Include="..\NovelReader.Dictionary\NovelReader.Dictionary.csproj" />
  </ItemGroup>

  <!--
    Builds the Angular workspace in client/ before the .NET build: the reader into wwwroot, and
    the admin panel (D45) into admin-ui, which is outside wwwroot so that only AdminController
    can serve it. Both are build output, wiped and rewritten by every client build. Requires
    Node. Build with -p:SkipClientBuild=true to reuse what is already there.
  -->
  <ItemGroup>
    <ClientSource Include="client\src\**\*" />
    <ClientSource Include="client\projects\**\*" />
    <ClientSource Include="client\angular.json;client\tsconfig.json;client\tsconfig.app.json;client\package.json;client\package-lock.json" />
    <Content Remove="client\**" />
    <None Remove="admin-ui\**" />
    <None Remove="client\**" />
    <Compile Remove="client\**" />
  </ItemGroup>

  <Target Name="EnsureNodeAvailable" Condition="'$(SkipClientBuild)' != 'true'">
    <Exec Command="node --version" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="_NodeExitCode" />
    </Exec>
    <Error Condition="'$(_NodeExitCode)' != '0'" Text="Node.js is required to build the Angular client. Install it (sudo pacman -S nodejs npm), or build with -p:SkipClientBuild=true to reuse what is already in wwwroot." />
  </Target>

  <Target Name="NpmInstall" DependsOnTargets="EnsureNodeAvailable" Condition="'$(SkipClientBuild)' != 'true'" Inputs="client\package.json;client\package-lock.json" Outputs="client\node_modules\.package-lock.json">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\client" />
  </Target>

  <Target Name="BuildClient" DependsOnTargets="NpmInstall" Condition="'$(SkipClientBuild)' != 'true'" BeforeTargets="BeforeBuild;ResolveStaticWebAssetsInputs" Inputs="@(ClientSource)" Outputs="wwwroot\index.html;admin-ui\index.html">
    <Exec Command="npx ng build novel-reader" WorkingDirectory="$(MSBuildProjectDirectory)\client" />
    <Exec Command="npx ng build admin" WorkingDirectory="$(MSBuildProjectDirectory)\client" />
  </Target>

  <!-- The client's files did not exist when the project was evaluated, so they are added here,
       after the client build, or a publish from a clean checkout would leave them out. -->
  <Target Name="IncludeClientOutput" AfterTargets="BuildClient" BeforeTargets="ResolveStaticWebAssetsInputs;AssignTargetPaths">
    <ItemGroup>
      <Content Include="wwwroot\**;admin-ui\**" Exclude="@(Content)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
